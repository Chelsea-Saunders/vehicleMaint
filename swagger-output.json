  "definitions": {
    "Vehicles": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "example": "Vin"
        },
        "brand": {
          "type": "string",
          "example": "Toyota"
        },
        "vin": {
          "type": "string",
          "example": "123456789asd"
        },
        "color": {
          "type": "string",
          "example": "Blue"
        },
        "year": {
          "type": "number",
          "example": 2020
        },
        "mileage": {
          "type": "number",
          "example": 56981
        }
      }
    },
    "MaintenanceRecord": {
      "type": "object",
      "properties": {
        "vin": {
          "type": "string",
          "example": "123456789asd"
        },
        "oil_change": {
          "type": "string",
          "example": "2026-01-15"
        },
        "tire_pressure": {
          "type": "number",
          "example": 35
        },
        "tire_rotation": {
          "type": "string",
          "example": "2026-01-15"
        },
        "tranny_flush": {
          "type": "string",
          "example": "2026-01-15"
        },
        "sparkplugs": {
          "type": "string",
          "example": "2026-01-15"
        },
        "coolant": {
          "type": "string",
          "example": "2026-01-15"
        },
        "wiper_fluid": {
          "type": "string",
          "example": "full"
        },
        "light_check": {
          "type": "string",
          "example": "2026-01-15"
        },
        "air_filter": {
          "type": "string",
          "example": "2026-01-15"
        },
        "fuel_filter": {
          "type": "string",
          "example": "2026-01-15"
        },
        "brakes": {
          "type": "string",
          "example": "2026-01-15"
        },
        "belts_hoses": {
          "type": "string",
          "example": "2026-01-15"
        },
        "steering_suspension": {
          "type": "string",
          "example": "2026-01-15"
        },
        "exhaust": {
          "type": "string",
          "example": "2026-01-15"
        }
