@baseUrl = http://localhost:3030
#To test the deploy version instead, comment the line above and use:
# @baseUrl = https://https://vehiclemaint.onrender.com

### Root check
GET {{baseUrl}}/ HTTP/1.1

### Get all vehicles
GET {{baseUrl}}/vehicles HTTP/1.1

###Get one vehicle by id
GET {{baseUrl}}/vehicles/6acd553ae4b43264bda846dd HTTP/1.1

### create a vehicle (title, brand, vin are required)
POST {{baseUrl}}/vehicles HTTP/1.1
Content-Type: application/json

{
    "title": "Family SUV", 
    "brand": "Honda", 
    "vin": "HON123",
    "color": "Silver", 
    "year": 2021,
    "mileage": 30000
}

### Replace a vehicle 
PUT {{baseUrl}}/vehicles/6acd553ae4b43264bda846dd HTTP/1.1
Content-Type: application/json
{
    "title": "Daily Driver", 
    "brand": "Toyota",
    "vin": "XYZ789",
    "color": "Blue",
    "year": "2020",
    "mileage": 42000
}

###Delete a vehicle
DELETE {{baseUrl}}/vehicles/6acd553ae4b43264bda846dd HTTP/1.1



### Get all maintenance records
GET {{baseUrl}}/maintenanceRecords HTTP/1.1

### Get one maint record by id
GET {{baseUrl}}/maintenanceRecords/6acd69be9b7f236b57e20a81 HTTP/1.1

### Create a maintenance record linked via vin
POST {{baseUrl}}/maintenanceRecords HTTP/1.1
Content-Type: application/application/json
{
    "vin": "XYZ789", 
    "oil_change": "2026-01-15",
    "tire_pressure": 32
}

###Update a maint record
PUT {{baseUrl}}/maintenanceRecords/6acd69be9b7f236b57e20a81 HTTP/1.1
Content-Type: application/json
{
    "vin": "XYZ789", 
    "oil_change": "2026-01-15", 
    "tire_pressure": 32
}

### Delete a maint record
DELETE {{baseUrl}}/maintenanceRecords/6acd69be9b7f236b57e20a81 HTTP/1.1